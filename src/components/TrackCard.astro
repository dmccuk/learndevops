---
import { publishedCount, type Track, unitsInTrack } from '../lib/curriculum';
import { trackUrl } from '../lib/url';
import Roundel from './Roundel.astro';

interface Props {
	track: Track;
}
const { track } = Astro.props;
const units = unitsInTrack(track.id);
const ready = publishedCount(units.map((u) => u.id));
---

<a class="ld-card track" href={trackUrl(track.id)} data-line={track.id.toLowerCase()}>
	<h3 class="ld-card-title"><Roundel track={track.id} /> {track.name}</h3>
	<p class="intro">{track.intro}</p>
	<p class="count">{units.length} units, {ready} ready{track.new && '. New track'}</p>
</a>

<style>
	.track {
		border-top: var(--ld-rail) solid var(--line);
	}
	.ld-card-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.intro {
		color: var(--ld-muted);
		font-size: 0.9375rem;
	}
	.count {
		margin-top: auto !important;
		font-size: 0.875rem;
		color: var(--ld-dim);
	}
</style>
