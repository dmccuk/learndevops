---
import { publishedCount, STAGE_LABELS, type Track, unitsInTrack } from '../lib/curriculum';
import { trackUrl } from '../lib/url';

interface Props {
	track: Track;
}
const { track } = Astro.props;
const units = unitsInTrack(track.id);
const ready = publishedCount(units.map((u) => u.id));
---

<a class:list={['ld-card', { new: track.new }]} href={trackUrl(track.id)}>
	<span class="ld-label">{STAGE_LABELS[track.stage]}{track.new && ' · New track'}</span>
	<h3 class="ld-card-title"><span class="id">{track.id}</span> {track.name}</h3>
	<p class="intro">{track.intro}</p>
	<p class="count">{units.length} units · {ready} ready</p>
</a>

<style>
	.new {
		border-color: var(--ld-accent);
	}
	.id {
		font-family: var(--__sl-font-mono);
		color: var(--ld-accent);
		margin-inline-end: 0.25rem;
	}
	.intro {
		color: var(--ld-muted);
		font-size: 0.9375rem;
	}
	.count {
		margin-top: auto !important;
		font-size: 0.875rem;
		color: var(--ld-dim);
	}
</style>
