---
import { getTrack, publishedCount, STAGE_LABELS, unitsInTrack } from '../../lib/curriculum';
import PipelineMap from '../PipelineMap.astro';
import UnitList from '../UnitList.astro';

interface Props {
	id: string;
}
const track = getTrack(Astro.props.id);
const units = unitsInTrack(track.id);
const stages = [...new Set(units.map((u) => u.stage))];
const ready = publishedCount(units.map((u) => u.id));
---

<p class="ld-label">
	Track {track.id} · {stages.map((s) => STAGE_LABELS[s]).join(' and ')}{track.new && ' · New track'}
</p>
<p class="lead">{track.intro}</p>
<p>{units.length} units, {ready} ready so far. Each unit stands alone, but they build on each other in order.</p>

<h2 id="units">Units</h2>
<UnitList ids={units.map((u) => u.id)} />

<h2 id="where-this-fits">Where this track fits</h2>
<PipelineMap highlightTrack={track.id} />

<style>
	.lead {
		font-size: 1.1875rem;
	}
</style>
