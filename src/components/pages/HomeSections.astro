---
// Home page sections below the hero (spec section 6, items 3 to 9).
import { curriculum } from '../../lib/curriculum';
import { url, YOUTUBE_URL } from '../../lib/url';
import PathCard from '../PathCard.astro';
import PipelineMap from '../PipelineMap.astro';
import ProjectCard from '../ProjectCard.astro';

const steps = [
	{ label: 'Read', text: 'A short lesson that explains the why.' },
	{ label: 'Do', text: 'A hands-on lab from a ready-made starting point.' },
	{ label: 'Check', text: 'A script tells you whether it worked.' },
	{ label: 'Watch', text: 'Videos on the London IAC YouTube channel, where available.' },
];
---

<div class="home not-content">
	<section class="band ai" aria-labelledby="ai">
		<div class="inner narrow">
			<h2 id="ai">Is DevOps still worth learning now AI writes code?</h2>
			<p>
				<strong>Yes.</strong> AI can write code, but someone still has to build it, test it, ship it, secure it and
				keep it running. AI means more code arrives, faster. That makes reliable pipelines, infrastructure as code and
				good monitoring matter more, not less.
			</p>
			<p><a href={url('/reference/faq/#is-devops-still-worth-learning-now-ai-writes-code')}>Read the full answer</a></p>
		</div>
	</section>

	<section class="band" aria-labelledby="big-picture">
		<div class="inner">
			<p class="ld-label">The big picture</p>
			<h2 id="big-picture">Every track teaches one stage of the same pipeline</h2>
			<PipelineMap interactive />
		</div>
	</section>

	<section class="band alt" aria-labelledby="ways-in">
		<div class="inner">
			<h2 id="ways-in">Pick a path, or just pick a unit</h2>
			<div class="ld-grid">
				{curriculum.paths.map((p) => <PathCard path={p} />)}
			</div>
			<p class="more"><a href={url('/curriculum/')}>See all 60 units</a></p>
		</div>
	</section>

	<section class="band" aria-labelledby="how">
		<div class="inner">
			<h2 id="how">How every unit works</h2>
			<ol class="steps">
				{
					steps.map((s, i) => (
						<li>
							<span class="ld-label">0{i + 1}</span>
							<h3>{s.label}</h3>
							<p>
								{s.label === 'Watch' ? (
									<>
										Videos on the <a href={YOUTUBE_URL}>London IAC YouTube channel</a>, where available.
									</>
								) : (
									s.text
								)}
							</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="band alt" aria-labelledby="projects" id="what-youll-build">
		<div class="inner">
			<p class="ld-label">What you'll build</p>
			<h2 id="projects">Three projects</h2>
			<div class="ld-grid">
				{curriculum.projects.map((p, i) => <ProjectCard project={p} number={i + 1} />)}
			</div>
		</div>
	</section>

	<section class="band" aria-labelledby="teacher">
		<div class="inner teacher">
			<div class="photo" role="img" aria-label="[PHOTO]">[PHOTO]</div>
			<div>
				<p class="ld-label">Who's teaching</p>
				<h2 id="teacher">[YOUR NAME]</h2>
				<p>[A few lines on your DevOps background]</p>
			</div>
		</div>
	</section>

	<section class="band alt cta" aria-labelledby="ready">
		<div class="inner narrow">
			<h2 id="ready">Ready? Unit L1 runs right here in your browser.</h2>
			<a class="ld-button" href={url('/units/l1/')}>Start unit L1</a>
		</div>
	</section>
</div>

<style>
	.home {
		/* Break out of Starlight's content column to full width bands. */
		margin-inline: calc(-1 * var(--sl-content-pad-x));
	}
	.band {
		padding: 3.5rem var(--sl-content-pad-x);
		border-top: 1px solid var(--ld-border);
	}
	.band.alt {
		background: var(--ld-bg-alt);
	}
	.inner {
		max-width: var(--ld-max);
		margin: 0 auto;
	}
	.inner.narrow {
		max-width: 46rem;
	}
	h2 {
		margin: 0.25rem 0 1.5rem;
		font-size: var(--sl-text-h2);
		line-height: 1.15;
		letter-spacing: -0.01em;
	}
	.ai p {
		font-size: 1.125rem;
	}
	.ai p + p {
		margin-top: 1rem;
	}
	.more {
		margin-top: 1.5rem;
	}
	.steps {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.steps li {
		padding: 1.25rem;
		border: 1px solid var(--ld-border);
		border-radius: var(--ld-radius-card);
		background: var(--ld-surface);
	}
	.steps h3 {
		margin: 0.25rem 0 0.5rem;
		font-size: var(--sl-text-h3);
	}
	.steps p {
		margin: 0;
		color: var(--ld-muted);
	}
	.teacher {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		align-items: center;
	}
	.photo {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 9rem;
		height: 9rem;
		border: 1px dashed var(--ld-border);
		border-radius: 50%;
		background: var(--ld-surface);
		font-family: var(--__sl-font-mono);
		color: var(--ld-dim);
	}
	.cta {
		text-align: center;
	}
	.cta h2 {
		margin-bottom: 1.5rem;
	}
</style>
