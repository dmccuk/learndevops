---
// Home page sections below the hero (spec section 6). Deliberately short:
// try Linux, see where the course goes, meet the teacher. The course map,
// paths and projects live on their own pages.
import { Image } from 'astro:assets';
import portrait from '../../assets/dennis-mccarthy.png';
import { url } from '../../lib/url';
import BrowserVM from '../BrowserVM.astro';
---

<div class="home not-content">
	<section class="band try" aria-labelledby="try">
		<div class="inner">
			<h2 id="try">Try Linux right now, in this browser</h2>
			<p class="intro">
				This is a real Linux computer running inside the page: no account, no install, nothing sent to a server. Start
				it, then try <code>ls</code>, <code>pwd</code> or <code>cat notes.txt</code>.
			</p>
			<BrowserVM
				setup="mkdir -p ~/practice && cd ~/practice && echo alpha > notes.txt && echo beta >> notes.txt && echo gamma >> notes.txt"
			/>
			<p class="next">
				Ready to learn it properly? <a href={url('/units/l1/')}>Start unit L1</a>, or open the{' '}
				<a href={url('/playground/network/')}>network playground</a> to run two servers that talk to each other.
			</p>
		</div>
	</section>

	<section class="band" aria-labelledby="journey">
		<div class="inner">
			<h2 id="journey">Where the course takes you</h2>
			<ol class="steps">
				<li>
					<h3>Linux in your browser</h3>
					<p>The command line, files, SSH and servers, with nothing to install.</p>
				</li>
				<li>
					<h3>A ready-made cloud workspace</h3>
					<p>Git, CI/CD, containers and infrastructure as code in GitHub Codespaces.</p>
				</li>
				<li>
					<h3>Real deploys</h3>
					<p>Ship a real app to AWS or Kubernetes, then monitor and secure it.</p>
				</li>
			</ol>
			<p class="more">
				<a href={url('/curriculum/')}>See the full curriculum</a> or <a href={url('/paths/')}>pick a learning path</a>.
			</p>
		</div>
	</section>

	<section class="band alt" aria-labelledby="teacher">
		<div class="inner teacher">
			<Image
				class="photo"
				src={portrait}
				alt="Dennis McCarthy"
				width={288}
				height={288}
				widths={[144, 288]}
				sizes="9rem"
				loading="lazy"
			/>
			<div>
				<h2 id="teacher">Who's teaching</h2>
				<p class="name">Dennis McCarthy</p>
				<p>
					I've spent 20 years automating Linux systems, and I run the London Infrastructure as Code meetup. From shell
					scripts to CI/CD pipelines and AI coding, I've seen a lot along the way.
				</p>
				<p class="more-about"><a href={url('/about/')}>More about the course</a></p>
			</div>
		</div>
	</section>
</div>

<style>
	.home {
		margin-inline: calc(-1 * var(--sl-content-pad-x));
	}
	.band {
		padding: 4rem var(--sl-content-pad-x);
		border-top: 1px solid var(--ld-border);
	}
	.band.alt {
		background: var(--ld-bg-alt);
	}
	.inner {
		max-width: var(--ld-max);
		margin: 0 auto;
	}
	h2 {
		margin: 0 0 1rem;
		font-size: var(--sl-text-h2);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.intro {
		max-width: 44rem;
		margin: 0 0 1.75rem;
		color: var(--ld-muted);
		font-size: 1.125rem;
	}
	.try {
		background: var(--ld-accent-tint);
	}
	.next {
		margin-top: 1.25rem;
	}
	.more {
		margin-top: 1.5rem;
	}
	/* The three stages are a real sequence, so they read left to right along
	   a rail, like stops on a line. */
	.steps {
		position: relative;
		display: grid;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 50rem) {
		.steps {
			grid-template-columns: repeat(3, 1fr);
		}
		.steps::before {
			content: '';
			position: absolute;
			top: 0.75rem;
			left: 0.75rem;
			right: 20%;
			height: var(--ld-rail);
			margin-top: calc(var(--ld-rail) / -2);
			border-radius: 3px;
			background: var(--ld-accent);
		}
	}
	.steps li {
		position: relative;
		padding-top: 2.25rem;
	}
	.steps li::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 1.5rem;
		height: 1.5rem;
		border: 4px solid var(--ld-accent);
		border-radius: 50%;
		background: var(--ld-bg);
	}
	.steps h3 {
		margin: 0 0 0.25rem;
		font-size: 1.375rem;
	}
	.steps p {
		margin: 0;
		color: var(--ld-muted);
	}
	.teacher {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		align-items: center;
	}
	.teacher > div {
		flex: 1 1 20rem;
	}
	.teacher h2 {
		margin-bottom: 0.5rem;
	}
	.name {
		margin: 0 0 0.25rem;
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--ld-heading);
	}
	.photo {
		flex-shrink: 0;
		width: 9rem;
		height: 9rem;
		object-fit: contain;
	}
	.more-about {
		margin-top: 0.75rem;
	}
</style>
