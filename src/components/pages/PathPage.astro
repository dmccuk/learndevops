---
import { getPath, getUnit, publishedCount, unitTitle } from '../../lib/curriculum';
import { unitUrl } from '../../lib/url';
import StationList from '../StationList.astro';

interface Props {
	id: string;
}
const path = getPath(Astro.props.id);
const minutes = path.units.reduce((sum, id) => sum + getUnit(id).minutes, 0);
const ready = publishedCount(path.units);
---

<p class="lead"><strong>For:</strong> {path.for}</p>
{
	path.units.length > 0 && (
		<p>
			{path.units.length} stops, {ready} ready so far. About {Math.round(minutes / 60)} hours of lab time. The route
			ends with: {path.endsWith}.
		</p>
	)
}

{
	path.units.length > 0 && (
		<>
			<h2 id="route">The route</h2>
			<StationList ids={path.units} mode="route" query={`?path=${path.id}`} />
		</>
	)
}

{
	path.optional.length > 0 && (
		<>
			<h2 id="optional">Optional extra</h2>
			<ul>
				{path.optional.map((id) => {
					const u = getUnit(id);
					return (
						<li>
							<a href={`${unitUrl(u.id)}?path=${path.id}`}>{unitTitle(u)}</a>: {u.outcome}
						</li>
					);
				})}
			</ul>
		</>
	)
}

<slot />

<style>
	.lead {
		font-size: 1.25rem;
	}
</style>
