---
// Unit header generated from curriculum.yaml (spec section 7.3, item 1),
// styled as a station sign with the line's stations underneath.
import { getTrack, getUnit, unitsInTrack } from '../lib/curriculum';
import { trackUrl } from '../lib/url';
import Badges from './Badges.astro';
import CostNotice from './CostNotice.astro';
import LineStrip from './LineStrip.astro';
import Roundel from './Roundel.astro';

interface Props {
	id: string;
}
const unit = getUnit(Astro.props.id);
const track = getTrack(unit.track);
const units = unitsInTrack(track.id);
const stop = units.findIndex((u) => u.id === unit.id) + 1;
---

<div class="unit-header not-content" data-line={track.id.toLowerCase()}>
	<div class="sign">
		<Roundel track={track.id} size="lg" />
		<p>
			<a href={trackUrl(track.id)}>{track.name}</a>
			<span class="stop">Stop {stop} of {units.length}</span>
		</p>
	</div>
	<LineStrip track={track.id} current={unit.id} />
	<Badges unit={unit} />
	{unit.costNote && <CostNotice />}
</div>

<style>
	.unit-header {
		display: grid;
		gap: 1rem;
		margin-bottom: 2rem;
		padding: 1rem 1.25rem 1.25rem;
		border: 1px solid var(--ld-border);
		border-top: var(--ld-rail) solid var(--line);
		border-radius: var(--ld-radius-card);
		background: var(--ld-surface);
	}
	.sign {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}
	.sign p {
		display: grid;
		margin: 0;
		line-height: 1.3;
	}
	.sign a {
		font-weight: 700;
		color: var(--ld-heading);
		text-decoration: none;
	}
	.sign a:hover {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}
	.stop {
		font-size: 0.9375rem;
		color: var(--ld-muted);
	}
</style>
