---
/**
 * Linux running inside the page, using the v86 emulator (BSD-2-Clause).
 *
 * Nothing heavy loads until the learner selects "Start". Then the emulator
 * (about 2.4 MB) and a saved VM state are fetched from this site, and files
 * load on demand as the VM reads them. Several VMs on one page share a
 * private in-browser network, with no server involved.
 *
 * The VM files live in public/vm/ and are built by
 * .github/workflows/browser-vm.yml (see labs/_browser-vm/README.md).
 */
interface VM {
	/** Hostname inside the VM, e.g. "web1" */
	name: string;
	/** Address on the in-browser network, e.g. "10.5.0.11/24" */
	ip: string;
}
interface Props {
	vms?: VM[];
	/** Commands typed into the first VM after it starts, e.g. setup files */
	setup?: string;
}
const { vms = [{ name: 'ld-control', ip: '10.5.0.10/24' }], setup = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ld-browser-vm class="not-content" data-vms={JSON.stringify(vms)} data-base={`${base}/vm/`} data-setup={setup}>
	<div class="start">
		<button type="button" class="ld-button" data-start>
			{vms.length > 1 ? `Start ${vms.length} Linux servers` : 'Start the Linux terminal'}
		</button>
		<p class="note">
			Runs entirely in your browser. The first start downloads about 25 MB; after that your browser caches it. The
			password for <code>sudo</code> is <code>learner</code>.
		</p>
	</div>
	<p class="status" role="status" aria-live="polite"></p>
	<div class="terms">
		{
			vms.map((vm) => (
				<section class="term-wrap" aria-label={`Terminal for ${vm.name}`} hidden>
					<h3 class="term-title">{vm.name}</h3>
					<div class="term" />
				</section>
			))
		}
	</div>
</ld-browser-vm>

<script>
	import '@xterm/xterm/css/xterm.css';

	type VMSpec = { name: string; ip: string };

	class LdBrowserVM extends HTMLElement {
		connectedCallback() {
			this.querySelector<HTMLButtonElement>('[data-start]')?.addEventListener('click', () => this.start(), {
				once: true,
			});
		}

		private setStatus(text: string) {
			const el = this.querySelector('.status');
			if (el) el.textContent = text;
		}

		private async start() {
			const startedAt = performance.now();
			const vms: VMSpec[] = JSON.parse(this.dataset.vms ?? '[]');
			const base = this.dataset.base ?? '/vm/';
			const startBox = this.querySelector<HTMLElement>('.start');
			startBox?.setAttribute('hidden', '');
			this.setStatus('Loading the emulator…');

			// Check the VM files are on the site before starting. Without them
			// v86 waits forever instead of reporting an error.
			const filesOk = await Promise.all(
				['v86.wasm', 'state.bin.zst', 'fs.json'].map((f) =>
					fetch(`${base}${f}`, { method: 'HEAD' })
						.then((r) => r.ok)
						.catch(() => false),
				),
			).then((all) => all.every(Boolean));
			if (!filesOk) {
				this.setStatus(
					'The Linux image is not available right now. It may still be publishing; try again in a few minutes.',
				);
				startBox?.removeAttribute('hidden');
				this.querySelector<HTMLButtonElement>('[data-start]')?.addEventListener('click', () => this.start(), {
					once: true,
				});
				return;
			}

			// If start-up stalls for any other reason, say so rather than hang.
			setTimeout(() => {
				if ((window as unknown as { ldVmReadySeconds?: number }).ldVmReadySeconds === undefined) {
					this.setStatus('This is taking longer than expected. Reload the page to try again.');
				}
			}, 90_000);

			const [{ V86 }, { Terminal }, { FitAddon }] = await Promise.all([
				import('v86'),
				import('@xterm/xterm'),
				import('@xterm/addon-fit'),
			]);

			// Measure the terminal font only after it has loaded, or letters misalign.
			await document.fonts.load("14px 'Overpass Mono'").catch(() => undefined);

			const wraps = [...this.querySelectorAll<HTMLElement>('.term-wrap')];
			let ready = 0;

			vms.forEach((vm, i) => {
				const wrap = wraps[i];
				wrap.hidden = false;
				const term = new Terminal({
					convertEol: false,
					cursorBlink: true,
					fontFamily: "'Overpass Mono', ui-monospace, monospace",
					fontSize: 14,
					theme: { background: '#0a131c', foreground: '#dce4ec', cursor: '#8fa8ff' },
				});
				const fit = new FitAddon();
				term.loadAddon(fit);
				term.open(wrap.querySelector('.term') as HTMLElement);
				fit.fit();
				new ResizeObserver(() => fit.fit()).observe(wrap);
				term.write(`Starting ${vm.name}…\r\n`);

				const emulator = new V86({
					wasm_path: `${base}v86.wasm`,
					bios: { url: `${base}seabios.bin` },
					vga_bios: { url: `${base}vgabios.bin` },
					memory_size: 256 * 1024 * 1024,
					vga_memory_size: 2 * 1024 * 1024,
					initial_state: { url: `${base}state.bin.zst` },
					filesystem: { baseurl: `${base}rootfs-flat/`, basefs: `${base}fs.json` },
					net_device: { type: 'virtio', relay_url: 'inbrowser' },
					autostart: true,
					disable_keyboard: true,
					disable_mouse: true,
					// No sound needed, and the speaker loads a blob: worklet the CSP blocks.
					disable_speaker: true,
				});

				emulator.add_listener('download-error', () => {
					term.write('\r\nThe Linux image could not be loaded. Check your connection and reload the page.\r\n');
					this.setStatus('The Linux image could not be loaded.');
				});

				// Batch output into one write per frame; byte-by-byte writes are slow.
				let pending: number[] = [];
				let scheduled = false;
				emulator.add_listener('serial0-output-byte', (byte: number) => {
					pending.push(byte);
					if (!scheduled) {
						scheduled = true;
						requestAnimationFrame(() => {
							term.write(new Uint8Array(pending));
							pending = [];
							scheduled = false;
						});
					}
				});
				// The emulated serial port only buffers a few characters, so long input
				// (start-up commands, pasted text) is fed in small chunks.
				let queue = '';
				let draining = false;
				const type = (text: string) => {
					queue += text;
					if (draining) return;
					draining = true;
					const drain = () => {
						if (!queue) {
							draining = false;
							return;
						}
						emulator.serial0_send(queue.slice(0, 8));
						queue = queue.slice(8);
						setTimeout(drain, 10);
					};
					drain();
				};
				term.onData((data: string) => type(data));

				// Start-up commands run one at a time, each after the shell prompt
				// comes back, so none of them is typed while another is running.
				let tail = '';
				let waitPrompt: (() => void) | null = null;
				emulator.add_listener('serial0-output-byte', (byte: number) => {
					tail = (tail + String.fromCharCode(byte)).slice(-64);
					if (waitPrompt && /\$ $/.test(tail)) {
						const done = waitPrompt;
						waitPrompt = null;
						done();
					}
				});
				const run = (cmd: string) =>
					new Promise<void>((resolve) => {
						tail = '';
						waitPrompt = resolve;
						type(`${cmd}\n`);
					});

				emulator.add_listener('emulator-ready', async () => {
					// Give this VM its own name and address. A new login shell picks up
					// the new hostname for the prompt.
					const w = window as unknown as { ldVmTimings?: string[] };
					w.ldVmTimings ??= [];
					const mark = (label: string) => w.ldVmTimings!.push(`${vm.name} ${label} ${((performance.now() - startedAt) / 1000).toFixed(1)}s`);
					mark('restored');
					await new Promise((r) => setTimeout(r, 300));
					await run('true');
					mark('first prompt');
					// Tell Linux the terminal's real size, so long lines wrap correctly.
					fit.fit();
					await run(`stty cols ${term.cols} rows ${term.rows}`);
					await run(`sudo ld-net ${vm.name} ${vm.ip}`);
					mark('ld-net');
					await run('exec bash');
					mark('new shell');
					if (i === 0 && this.dataset.setup) await run(this.dataset.setup);
					mark('setup');
					type('clear\n');
					ready++;
					if (ready === vms.length) {
						const secs = ((performance.now() - startedAt) / 1000).toFixed(1);
						this.setStatus(`${vms.length > 1 ? 'Servers' : 'Terminal'} ready in ${secs} s.`);
						(window as unknown as { ldVmReadySeconds?: number }).ldVmReadySeconds = Number(secs);
					}
				});
			});
			this.setStatus('Starting Linux…');
		}
	}
	customElements.define('ld-browser-vm', LdBrowserVM);
</script>

<style>
	ld-browser-vm {
		display: block;
		margin: 1.5rem 0;
	}
	.start {
		display: grid;
		justify-items: start;
		gap: 0.75rem;
		padding: 1.5rem;
		border: 1px solid var(--ld-border);
		border-radius: var(--ld-radius-card);
		background: var(--ld-surface);
	}
	.start[hidden] {
		display: none;
	}
	.note {
		margin: 0;
		color: var(--ld-muted);
		font-size: 0.9375rem;
	}
	.status {
		margin: 0 0 0.5rem;
		color: var(--ld-muted);
		font-size: 0.9375rem;
	}
	.terms {
		display: grid;
		gap: 1rem;
	}
	/* Side by side only where each terminal still gets about 80 columns. */
	ld-browser-vm {
		container-type: inline-size;
	}
	@container (min-width: 90rem) {
		.terms:has(.term-wrap:nth-child(2):not([hidden])) {
			grid-template-columns: 1fr 1fr;
		}
	}
	.term-wrap {
		min-width: 0;
		border: 1px solid var(--ld-border);
		border-radius: var(--ld-radius-card);
		background: #0a131c;
		overflow: hidden;
	}
	.term-wrap[hidden] {
		display: none;
	}
	.term-title {
		margin: 0;
		padding: 0.5rem 0.875rem 0.375rem;
		border-bottom: 1px solid #2a3c4e;
		color: #dce4ec;
		font-size: 0.9375rem;
	}
	.term {
		height: 26rem;
		padding: 0.5rem;
	}
</style>
