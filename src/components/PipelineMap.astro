---
/**
 * The DevOps pipeline, with each track placed at the stage it teaches
 * (spec section 8.1).
 *
 * At 640px and wider this renders an SVG diagram. Below 640px it renders a
 * single-column list of stages with track chips. The SVG has role="img" and a
 * full text alternative. When `interactive` is set, the same list is kept in
 * the page for keyboard and screen reader users and becomes visible when one
 * of its links has focus.
 */
import { getTrack, type Stage } from '../lib/curriculum';
import { trackUrl } from '../lib/url';

interface Props {
	highlightStage?: Stage;
	highlightTrack?: string;
	interactive?: boolean;
	title?: string;
}

const { highlightStage, highlightTrack, interactive = false, title } = Astro.props;

type Chip = { id: string; label: string };
const STAGES: { stage: Stage; label: string; chips: Chip[] }[] = [
	{ stage: 'code', label: 'Code', chips: [{ id: 'G', label: 'Git and collaboration' }, { id: 'AI', label: 'AI in DevOps (optional)' }] },
	{ stage: 'build-test', label: 'Build and test', chips: [{ id: 'P', label: 'CI/CD: test and build' }] },
	{ stage: 'package', label: 'Package', chips: [{ id: 'C', label: 'Containers' }] },
	{ stage: 'provision', label: 'Provision', chips: [{ id: 'I', label: 'Infrastructure as code' }, { id: 'W', label: 'Cloud with AWS' }] },
	{ stage: 'configure', label: 'Configure', chips: [{ id: 'A', label: 'Configuration (Ansible)' }] },
	{ stage: 'deploy', label: 'Deploy', chips: [{ id: 'K', label: 'Kubernetes' }, { id: 'P', label: 'CI/CD: deploy, GitOps' }] },
	{ stage: 'operate', label: 'Run and operate', chips: [{ id: 'R', label: 'Running production' }] },
	{ stage: 'observe', label: 'Observe', chips: [{ id: 'O', label: 'Observability' }] },
];
const SECURITY: Chip[] = [{ id: 'S', label: 'DevSecOps (secrets, scanning, policy)' }];
const FOUNDATIONS: Chip[] = [
	{ id: 'L', label: 'Linux and the shell' },
	{ id: 'N', label: 'Networking' },
];

const isNew = (id: string) => getTrack(id).new;
const anyHighlight = Boolean(highlightStage || highlightTrack);
const chipOn = (stage: Stage, id: string) =>
	!anyHighlight || stage === highlightStage || id === highlightTrack;
const stageOn = (stage: Stage, chips: Chip[]) =>
	!anyHighlight || stage === highlightStage || chips.some((c) => c.id === highlightTrack);

// --- SVG geometry ---------------------------------------------------------
const W = 800;
const LEFT = 64; // room for the return arrow
const STAGE_W = 200;
const ROW_H = 48;
const GAP = 22;
const CHIP_X = LEFT + STAGE_W + 36;
const CHIP_H = 32;
const TOP = 16;
const chipWidth = (c: Chip) => 26 + c.id.length * 8.4 + c.label.length * 7.1;

const rows = STAGES.map((s, i) => {
	const y = TOP + i * (ROW_H + GAP);
	let x = CHIP_X;
	const chips = s.chips.map((c) => {
		const w = chipWidth(c);
		const chip = { ...c, x, w, y: y + (ROW_H - CHIP_H) / 2 };
		x += w + 10;
		return chip;
	});
	return { ...s, y, chips };
});
const lastY = TOP + (STAGES.length - 1) * (ROW_H + GAP);
const bandY1 = lastY + ROW_H + 30;
const bandY2 = bandY1 + 56;
const keyY = bandY2 + 66;
const H = keyY + 24;

const alt =
	'The DevOps pipeline, top to bottom: ' +
	STAGES.map((s) => `${s.label} (${s.chips.map((c) => `${c.id} ${c.label}`).join(', ')})`).join(', then ') +
	'. A return arrow from Observe back to Code says: what you observe feeds the next change. ' +
	`Across every stage: ${SECURITY.map((c) => `${c.id} ${c.label}`).join(', ')}. ` +
	`Underneath everything: ${FOUNDATIONS.map((c) => `${c.id} ${c.label}`).join(', ')}. ` +
	'New tracks: Kubernetes, DevSecOps, Running production and AI in DevOps.' +
	(highlightStage ? ` Highlighted stage: ${highlightStage}.` : '');

const uid = `pm-${Math.random().toString(36).slice(2, 8)}`;
const listId = `${uid}-list`;
---

<figure class:list={['pipeline-map', { interactive }]}>
	{title && <figcaption class="pm-title">{title}</figcaption>}

	<svg
		class="pm-svg"
		viewBox={`0 0 ${W} ${H}`}
		role="img"
		aria-labelledby={`${uid}-t ${uid}-d`}
		preserveAspectRatio="xMinYMin meet"
	>
		<title id={`${uid}-t`}>Every track teaches one stage of the same pipeline</title>
		<desc id={`${uid}-d`}>{alt}</desc>
		<defs>
			<marker id={`${uid}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0,0 L10,5 L0,10 z" class="pm-arrowhead"></path>
			</marker>
		</defs>

		{/* Return arrow: Observe → Code */}
		<path
			class="pm-return"
			d={`M ${LEFT} ${lastY + ROW_H / 2} H ${LEFT - 30} V ${TOP + ROW_H / 2} H ${LEFT - 4}`}
			marker-end={`url(#${uid}-arrow)`}
		></path>
		<text
			class="pm-return-label"
			transform={`translate(${LEFT - 40} ${(TOP + lastY + ROW_H) / 2}) rotate(-90)`}
			text-anchor="middle"
		>
			What you observe feeds the next change
		</text>

		{
			rows.map((r, i) => (
				<g class:list={['pm-row', { dim: !stageOn(r.stage, r.chips) }]}>
					{i < rows.length - 1 && (
						<line
							class="pm-link"
							x1={LEFT + STAGE_W / 2}
							x2={LEFT + STAGE_W / 2}
							y1={r.y + ROW_H}
							y2={r.y + ROW_H + GAP - 2}
							marker-end={`url(#${uid}-arrow)`}
						/>
					)}
					<rect
						class:list={['pm-stage', { on: r.stage === highlightStage }]}
						x={LEFT}
						y={r.y}
						width={STAGE_W}
						height={ROW_H}
						rx="6"
					/>
					<text class="pm-stage-label" x={LEFT + 16} y={r.y + ROW_H / 2 + 5}>
						{r.label}
					</text>
					<line class="pm-tie" x1={LEFT + STAGE_W} x2={CHIP_X - 6} y1={r.y + ROW_H / 2} y2={r.y + ROW_H / 2} />
					{r.chips.map((c) => {
						const chip = (
							<g class:list={['pm-chip', { new: isNew(c.id), on: anyHighlight && chipOn(r.stage, c.id), dim: !chipOn(r.stage, c.id) }]}>
								<rect x={c.x} y={c.y} width={c.w} height={CHIP_H} rx="6" />
								<text x={c.x + 12} y={c.y + CHIP_H / 2 + 4.5}>
									<tspan class="pm-chip-id">{c.id}</tspan>
									<tspan dx="7">{c.label}</tspan>
								</text>
							</g>
						);
						return interactive ? (
							<a href={trackUrl(c.id)} tabindex="-1" aria-hidden="true">
								{chip}
							</a>
						) : (
							chip
						);
					})}
				</g>
			))
		}

		{
			[
				{ y: bandY1, lead: 'Across every stage', chips: SECURITY, stage: 'security' as Stage },
				{ y: bandY2, lead: 'Underneath everything', chips: FOUNDATIONS, stage: 'foundations' as Stage },
			].map((b) => {
				const on = !anyHighlight || b.stage === highlightStage || b.chips.some((c) => c.id === highlightTrack);
				let x = LEFT + 210;
				return (
					<g class:list={['pm-band', { dim: !on, on: anyHighlight && on }]}>
						<rect x={LEFT} y={b.y} width={W - LEFT - 8} height={44} rx="6" />
						<text class="pm-band-lead" x={LEFT + 16} y={b.y + 27}>
							{b.lead}
						</text>
						{b.chips.map((c) => {
							const cx = x;
							x += chipWidth(c) + 10;
							const body = (
								<g class:list={['pm-chip', { new: isNew(c.id) }]}>
									<rect x={cx} y={b.y + 6} width={chipWidth(c)} height={CHIP_H} rx="6" />
									<text x={cx + 12} y={b.y + 6 + CHIP_H / 2 + 4.5}>
										<tspan class="pm-chip-id">{c.id}</tspan>
										<tspan dx="7">{c.label}</tspan>
									</text>
								</g>
							);
							return interactive ? (
								<a href={trackUrl(c.id)} tabindex="-1" aria-hidden="true">
									{body}
								</a>
							) : (
								body
							);
						})}
					</g>
				);
			})
		}

		<g class="pm-key">
			<rect class="pm-key-swatch" x={LEFT} y={keyY} width="28" height="18" rx="4"></rect>
			<text x={LEFT + 38} y={keyY + 13.5}>New track</text>
			<rect class="pm-key-swatch-old" x={LEFT + 140} y={keyY} width="28" height="18" rx="4"></rect>
			<text x={LEFT + 178} y={keyY + 13.5}>Existing track</text>
		</g>
	</svg>

	<div class="pm-list-wrap" id={listId}>
		<ol class="pm-list">
			{
				STAGES.map((s) => (
					<li class:list={['pm-list-stage', { on: s.stage === highlightStage, dim: !stageOn(s.stage, s.chips) }]}>
						<span class="pm-list-label">
							{s.label}
							{s.stage === highlightStage && <span class="ld-sr-only">(this unit)</span>}
						</span>
						<ul class="pm-list-chips">
							{s.chips.map((c) => (
								<li>
									{interactive ? (
										<a class:list={['pm-list-chip', { new: isNew(c.id) }]} href={trackUrl(c.id)}>
											<b>{c.id}</b> {c.label}
											{isNew(c.id) && <span class="ld-sr-only">(new track)</span>}
										</a>
									) : (
										<span class:list={['pm-list-chip', { new: isNew(c.id) }]}>
											<b>{c.id}</b> {c.label}
											{isNew(c.id) && <span class="ld-sr-only">(new track)</span>}
										</span>
									)}
								</li>
							))}
						</ul>
					</li>
				))
			}
		</ol>
		<p class="pm-list-loop">What you observe feeds the next change.</p>
		{
			[
				{ lead: 'Across every stage', chips: SECURITY, stage: 'security' },
				{ lead: 'Underneath everything', chips: FOUNDATIONS, stage: 'foundations' },
			].map((b) => (
				<div class:list={['pm-list-band', { on: b.stage === highlightStage }]}>
					<span class="pm-list-label">{b.lead}</span>
					<ul class="pm-list-chips">
						{b.chips.map((c) => (
							<li>
								{interactive ? (
									<a class:list={['pm-list-chip', { new: isNew(c.id) }]} href={trackUrl(c.id)}>
										<b>{c.id}</b> {c.label}
										{isNew(c.id) && <span class="ld-sr-only">(new track)</span>}
									</a>
								) : (
									<span class:list={['pm-list-chip', { new: isNew(c.id) }]}>
										<b>{c.id}</b> {c.label}
										{isNew(c.id) && <span class="ld-sr-only">(new track)</span>}
									</span>
								)}
							</li>
						))}
					</ul>
				</div>
			))
		}
		<p class="pm-list-key" aria-hidden="true"><span class="pm-list-chip new">New track</span></p>
	</div>
</figure>

<style>
	.pipeline-map {
		margin: 1.5rem 0;
		max-width: 100%;
	}
	.pm-title {
		margin-bottom: 1rem;
		font-weight: 600;
		color: var(--ld-heading);
	}

	/* --- SVG (640px and up) --- */
	.pm-svg {
		display: none;
		width: 100%;
		height: auto;
		font-family: var(--__sl-font);
		font-size: 13px;
	}
	.pm-stage {
		fill: var(--ld-surface);
		stroke: var(--ld-border);
	}
	.pm-stage.on {
		stroke: var(--ld-accent);
		stroke-width: 2;
	}
	.pm-stage-label {
		fill: var(--ld-heading);
		font-size: 15px;
		font-weight: 600;
	}
	.pm-link,
	.pm-tie,
	.pm-return {
		stroke: var(--ld-dim);
		stroke-width: 1.25;
		fill: none;
	}
	.pm-tie {
		stroke-dasharray: 2 3;
	}
	.pm-return {
		stroke-dasharray: 4 3;
	}
	.pm-arrowhead {
		fill: var(--ld-dim);
	}
	.pm-return-label {
		fill: var(--ld-dim);
		font-size: 12px;
	}
	.pm-chip rect {
		fill: var(--ld-bg);
		stroke: var(--ld-border);
	}
	.pm-chip text {
		fill: var(--ld-text);
	}
	.pm-chip-id {
		font-family: var(--__sl-font-mono);
		font-weight: 600;
		fill: var(--ld-heading);
	}
	.pm-chip.new rect {
		stroke: var(--ld-accent);
	}
	.pm-chip.on rect {
		fill: var(--ld-accent-tint);
		stroke: var(--ld-accent);
		stroke-width: 2;
	}
	a .pm-chip:hover rect {
		stroke: var(--ld-accent);
		stroke-width: 2;
	}
	.pm-band > rect {
		fill: var(--ld-bg-alt);
		stroke: var(--ld-border);
	}
	.pm-band.on > rect {
		stroke: var(--ld-accent);
		stroke-width: 2;
	}
	.pm-band-lead {
		fill: var(--ld-muted);
		font-size: 13px;
		font-weight: 600;
	}
	.dim {
		opacity: 0.4;
	}
	.pm-key text {
		fill: var(--ld-muted);
		font-size: 12px;
	}
	.pm-key-swatch {
		fill: var(--ld-bg);
		stroke: var(--ld-accent);
	}
	.pm-key-swatch-old {
		fill: var(--ld-bg);
		stroke: var(--ld-border);
	}

	/* --- List (below 640px) --- */
	.pm-list-wrap {
		display: block;
	}
	.pm-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}
	.pm-list-stage,
	.pm-list-band {
		margin: 0 !important;
		padding: 0.75rem;
		border: 1px solid var(--ld-border);
		border-radius: var(--ld-radius);
		background: var(--ld-surface);
	}
	.pm-list-band {
		margin-top: 0.5rem !important;
		background: var(--ld-bg-alt);
	}
	.pm-list-stage.on,
	.pm-list-band.on {
		border-color: var(--ld-accent);
		border-width: 2px;
	}
	.pm-list-stage.dim {
		opacity: 0.55;
	}
	.pm-list-label {
		display: block;
		font-weight: 600;
		color: var(--ld-heading);
	}
	.pm-list-chips {
		list-style: none;
		margin: 0.5rem 0 0 !important;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.pm-list-chips li {
		margin: 0 !important;
	}
	.pm-list-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 44px;
		padding: 0.25rem 0.75rem;
		border: 1px solid var(--ld-border);
		border-radius: var(--ld-radius);
		background: var(--ld-bg);
		color: var(--ld-text);
		font-size: 0.9375rem;
		text-decoration: none;
	}
	.pm-list-chip b {
		font-family: var(--__sl-font-mono);
		color: var(--ld-heading);
	}
	.pm-list-chip.new {
		border-color: var(--ld-accent);
	}
	a.pm-list-chip:hover,
	a.pm-list-chip:focus-visible {
		border-color: var(--ld-accent);
		color: var(--ld-accent);
	}
	.pm-list-loop,
	.pm-list-key {
		margin: 0.5rem 0 0 !important;
		font-size: 0.875rem;
		color: var(--ld-dim);
	}
	.pm-list-key .pm-list-chip {
		min-height: 0;
		font-size: 0.8125rem;
	}

	@media (min-width: 640px) {
		.pm-svg {
			display: block;
		}
		/* Non-interactive: the SVG's text alternative covers everything. */
		.pipeline-map:not(.interactive) .pm-list-wrap {
			display: none;
		}
		/* Interactive: keep the links for keyboard and screen reader users,
		   visible only while one of them has focus. */
		.pipeline-map.interactive .pm-list-wrap {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
		}
		.pipeline-map.interactive .pm-list-wrap:focus-within {
			position: static;
			width: auto;
			height: auto;
			overflow: visible;
			clip: auto;
			margin-top: 1rem;
		}
	}
</style>
