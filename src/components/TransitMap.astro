---
/**
 * The course as a metro network: every track is a line, every unit a station.
 * Lines are listed in pipeline order. Stations are real links, so the map
 * works with a keyboard and a screen reader, and without JavaScript.
 *
 * Filled station: unit ready. Hollow: coming soon. Double ring: an
 * interchange, a unit that other lines build on.
 */
import { curriculum, getTrack, unitsInTrack, unitTitle } from '../lib/curriculum';
import { trackUrl, unitUrl } from '../lib/url';
import Roundel from './Roundel.astro';

interface Props {
	/** Heading level for the line names. */
	compact?: boolean;
}
const { compact = false } = Astro.props;

const ORDER = ['L', 'N', 'G', 'AI', 'P', 'C', 'I', 'W', 'A', 'K', 'R', 'O', 'S'];
const lines = ORDER.map((id) => ({ track: getTrack(id), units: unitsInTrack(id) }));
const isInterchange = (id: string, track: string) =>
	curriculum.units.some((u) => u.track !== track && u.prerequisites.includes(id));

const status = (s: string) => (s === 'published' ? 'ready' : s === 'draft' ? 'draft' : 'coming soon');
---

<div class:list={['transit-map', { compact }]}>
	<ol class="lines" aria-label="Course map: tracks as lines, units as stations">
		{
			lines.map(({ track, units }) => (
				<li class="line" data-line={track.id.toLowerCase()}>
					<a class="line-name" href={trackUrl(track.id)}>
						<Roundel track={track.id} />
						<span>{track.name}</span>
					</a>
					<ol class="stations" style={`--n: ${units.length}`}>
						{units.map((u) => {
							const ix = isInterchange(u.id, u.track);
							return (
								<li class="station">
									<a
										href={unitUrl(u.id)}
										class:list={['stop', u.status, { interchange: ix }]}
										aria-label={`${unitTitle(u)}, ${status(u.status)}${ix ? ', interchange' : ''}`}
									>
										<span class="dot" aria-hidden="true" />
										<span class="id" aria-hidden="true">
											{u.id}
										</span>
										<span class="tip" aria-hidden="true">
											<strong>{u.id}</strong> {u.title}
										</span>
									</a>
								</li>
							);
						})}
					</ol>
				</li>
			))
		}
	</ol>
	<ul class="key" aria-label="Map key">
		<li><span class="dot ready" aria-hidden="true"></span> Ready</li>
		<li><span class="dot" aria-hidden="true"></span> Coming soon</li>
		<li><span class="dot interchange" aria-hidden="true"></span> Interchange: other tracks build on it</li>
	</ul>
</div>

<style>
	/* Ten stations must fit a 360px phone inside the hero panel. */
	.transit-map {
		--stop: 1.55rem;
		--dot: 0.85rem;
	}
	@media (min-width: 40rem) {
		.transit-map {
			--stop: 2rem;
		}
	}
	.lines {
		display: grid;
		gap: 0.375rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.line {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.25rem;
		align-items: center;
		margin: 0 !important;
	}
	@media (min-width: 40rem) {
		.line {
			grid-template-columns: 13.5rem 1fr;
			gap: 0.75rem;
		}
		.compact .line {
			grid-template-columns: 12rem 1fr;
		}
	}
	.line-name {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 44px;
		color: var(--ld-heading);
		font-weight: 700;
		font-size: 0.9375rem;
		line-height: 1.2;
		text-decoration: none;
	}
	.line-name:hover span:last-child,
	.line-name:focus-visible span:last-child {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	/* The rail: a thick bar in the line colour behind the stations. */
	.stations {
		position: relative;
		display: grid;
		/* Ten columns that share the width, so stations line up across lines. */
		grid-template-columns: repeat(10, minmax(var(--stop), 1fr));
		margin: 0 !important;
		padding: 0;
		list-style: none;
	}
	.stations::before {
		content: '';
		position: absolute;
		top: calc(22px - var(--ld-rail) / 2);
		left: 5%;
		width: calc((var(--n) - 1) * 10%);
		height: var(--ld-rail);
		border-radius: 3px;
		background: var(--line);
	}

	.station {
		position: relative;
		margin: 0 !important;
	}
	.stop {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		min-height: 44px;
		padding-top: calc(22px - var(--dot) / 2);
		color: var(--ld-dim);
		text-decoration: none;
	}
	.dot {
		display: block;
		width: var(--dot);
		height: var(--dot);
		border: 3px solid var(--line, var(--ld-muted));
		border-radius: 50%;
		background: var(--ld-surface);
	}
	.ready .dot,
	.key .dot.ready {
		background: var(--line, var(--ld-muted));
	}
	.interchange .dot,
	.key .dot.interchange {
		width: calc(var(--dot) + 0.3rem);
		height: calc(var(--dot) + 0.3rem);
		margin-top: -0.15rem;
		border: 3px solid var(--ld-heading);
		box-shadow: inset 0 0 0 2px var(--ld-surface), inset 0 0 0 5px var(--line, var(--ld-muted));
	}
	.id {
		margin-top: 0.2rem;
		font-size: 0.6875rem;
		font-weight: 600;
		line-height: 1;
		color: var(--ld-dim);
	}
	.stop:hover .id,
	.stop:focus-visible .id {
		color: var(--ld-heading);
	}

	/* Station name on hover or focus */
	.tip {
		position: absolute;
		bottom: calc(100% - 0.25rem);
		left: 50%;
		z-index: 2;
		width: max-content;
		max-width: 16rem;
		padding: 0.35rem 0.6rem 0.2rem;
		border: 1px solid var(--ld-border);
		border-radius: var(--ld-radius);
		background: var(--ld-surface);
		color: var(--ld-text);
		font-size: 0.8125rem;
		line-height: 1.3;
		transform: translateX(-50%);
		pointer-events: none;
		/* display, not visibility: hidden tips must not widen the page. */
		display: none;
	}
	.stop:hover .tip,
	.stop:focus-visible .tip {
		display: block;
	}
	/* Tips near the right end open inwards. */
	.station:nth-child(n + 7) .tip {
		left: auto;
		right: 0;
		transform: none;
	}
	.station:nth-child(-n + 2) .tip {
		left: 0;
		transform: none;
	}
	.stop:focus-visible {
		outline: 2px solid var(--ld-accent);
		outline-offset: 2px;
		border-radius: 4px;
	}

	.key {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 1.25rem 0 0 !important;
		padding: 0;
		list-style: none;
		font-size: 0.875rem;
		color: var(--ld-muted);
	}
	.key li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 !important;
	}
	.key .dot {
		--line: var(--ld-muted);
	}
</style>
