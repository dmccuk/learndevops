---
// Stage, environment, time and status pills for a unit.
import { ENVIRONMENT_LABELS, getTrack, STAGE_LABELS, type Unit } from '../lib/curriculum';

interface Props {
	unit: Unit;
	compact?: boolean;
}
const { unit, compact = false } = Astro.props;
const track = getTrack(unit.track);
const where = [unit.runsIn, ...unit.alsoRunsIn].map((e) => ENVIRONMENT_LABELS[e]).join(' or ');
---

<ul class="badges" aria-label="Unit details">
	{!compact && <li class="ld-badge">{STAGE_LABELS[unit.stage]} stage</li>}
	<li class="ld-badge">{where}</li>
	<li class="ld-badge">{unit.minutes} min</li>
	{!compact && track.new && <li class="ld-badge accent">New track</li>}
	{unit.costNote && <li class="ld-badge warn">Costs money</li>}
	{unit.status === 'planned' && <li class="ld-badge">Coming soon</li>}
	{unit.status === 'draft' && <li class="ld-badge warn">Draft</li>}
</ul>

<style>
	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 0 !important;
		padding: 0;
		list-style: none;
	}
	.badges li {
		margin: 0 !important;
	}
</style>
