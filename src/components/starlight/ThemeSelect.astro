---
// Dark and light only. Dark is the default (spec section 5). The choice is
// saved in localStorage when storage is available; the site works without it.
import Select from '@astrojs/starlight/components/Select.astro';
---

<starlight-theme-select>
	<Select
		icon="moon"
		label={Astro.locals.t('themeSelect.accessibleLabel')}
		options={[
			{ label: Astro.locals.t('themeSelect.dark'), selected: true, value: 'dark' },
			{ label: Astro.locals.t('themeSelect.light'), selected: false, value: 'light' },
		]}
		width="6.25em"
	/>
</starlight-theme-select>

{/* Inlined to avoid a flash. Uses global scope from ThemeProvider.astro */}
<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'dark' | 'light';
	const storageKey = 'starlight-theme';
	const parseTheme = (theme: unknown): Theme => (theme === 'light' ? 'light' : 'dark');

	function loadTheme(): Theme {
		try {
			return parseTheme(localStorage.getItem(storageKey));
		} catch {
			return 'dark';
		}
	}

	function onThemeChange(theme: Theme): void {
		StarlightThemeProvider.updatePickers(theme);
		document.documentElement.dataset.theme = theme;
		try {
			localStorage.setItem(storageKey, theme);
		} catch {
			// Storage blocked: the choice lasts for this page only.
		}
	}

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			StarlightThemeProvider.updatePickers(loadTheme());
			this.querySelector('select')?.addEventListener('change', (e) => {
				if (e.currentTarget instanceof HTMLSelectElement) {
					onThemeChange(parseTheme(e.currentTarget.value));
				}
			});
		}
	}
	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>
