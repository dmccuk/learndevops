---
// Logo: a short stretch of line with an interchange station, then the name.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label="Learn DevOps home">
	<svg class="mark" viewBox="0 0 40 20" width="40" height="20" aria-hidden="true">
		<rect x="0" y="7" width="40" height="6" rx="3" class="rail"></rect>
		<circle cx="20" cy="10" r="7.5" class="ring"></circle>
		<circle cx="20" cy="10" r="3" class="core"></circle>
	</svg>
	<span aria-hidden="true">learndevops<span class="tld">.co.uk</span></span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 44px;
		font-weight: 800;
		font-size: 1.1875rem;
		letter-spacing: -0.02em;
		color: var(--ld-heading);
		text-decoration: none;
		white-space: nowrap;
	}
	.tld {
		font-weight: 600;
		color: var(--ld-dim);
	}
	/* Leave room for search and the menu button on small phones. */
	@media (max-width: 26rem) {
		.tld {
			display: none;
		}
		.mark {
			width: 30px;
		}
	}
	.rail {
		fill: var(--ld-accent);
	}
	.ring {
		fill: var(--ld-surface);
		stroke: var(--ld-heading);
		stroke-width: 3;
	}
	.core {
		fill: var(--ld-accent);
	}
</style>
