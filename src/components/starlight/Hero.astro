---
// Home page hero (spec section 6, item 2). Kept short so the live terminal
// below it is the first thing to try. The course map lives on /curriculum/.
import { url } from '../../lib/url';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
---

<section class="hero">
	<div class="copy">
		<p class="kicker">Free and hands-on. Nothing to install to start.</p>
		<h1 id="_top" data-page-title>{title}</h1>
		{tagline && <p class="tagline">{tagline}</p>}
		<div class="actions">
			<a class="ld-button" href={url('/units/l1/')}>Start unit L1</a>
			<a class="ld-button secondary" href={url('/curriculum/')}>See the curriculum</a>
		</div>
		<p class="small">Works on Windows, Mac and Linux. All you need is a browser and a free GitHub account.</p>
	</div>
</section>

<style>
	.hero {
		max-width: 46rem;
		padding-block: 1.5rem 3rem;
	}
	@media (min-width: 72rem) {
		.hero {
			padding-block: 4rem 3.5rem;
		}
	}
	.kicker {
		margin: 0;
		font-weight: 600;
		color: var(--ld-muted);
	}
	h1 {
		margin: 0.75rem 0 1rem;
		font-size: clamp(2.5rem, 4vw, 3.75rem);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: -0.03em;
		color: var(--ld-heading);
	}
	.tagline {
		max-width: 34rem;
		font-size: 1.1875rem;
		line-height: 1.55;
		color: var(--ld-text);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.small {
		margin-top: 1rem;
		font-size: 0.9375rem;
		color: var(--ld-dim);
	}
</style>
