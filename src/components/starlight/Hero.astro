---
// Home page hero (spec section 6, item 2). The course map is the hero: every
// track a line, every unit a station. Only the home page sets `hero`.
import { REPO_URL, url } from '../../lib/url';
import TransitMap from '../TransitMap.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
---

<section class="hero">
	<div class="copy">
		<p class="kicker">Free and hands-on. Nothing to install to start.</p>
		<h1 id="_top" data-page-title>{title}</h1>
		{tagline && <p class="tagline">{tagline}</p>}
		<div class="actions">
			<a class="ld-button" href={url('/units/l1/')}>Start unit L1</a>
			<a class="ld-button secondary" href={REPO_URL}>View the code on GitHub</a>
		</div>
		<p class="small">Works on Windows, Mac and Linux. All you need is a browser and a free GitHub account.</p>
	</div>
	<div class="map">
		<h2 class="ld-sr-only">Course map</h2>
		<TransitMap />
	</div>
</section>

<style>
	.hero {
		display: grid;
		gap: 2.5rem;
		padding-block: 1.5rem 3rem;
	}
	@media (min-width: 72rem) {
		.hero {
			grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
			gap: 3.5rem;
			align-items: center;
			padding-block: 3.5rem 4.5rem;
		}
	}
	.kicker {
		margin: 0;
		font-weight: 600;
		color: var(--ld-muted);
	}
	h1 {
		margin: 0.75rem 0 1rem;
		font-size: clamp(2.5rem, 4vw, 3.75rem);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: -0.03em;
		color: var(--ld-heading);
	}
	.tagline {
		max-width: 34rem;
		font-size: 1.1875rem;
		line-height: 1.55;
		color: var(--ld-text);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.small {
		margin-top: 1rem;
		font-size: 0.9375rem;
		color: var(--ld-dim);
	}
	.map {
		min-width: 0;
		padding: 1.25rem 1rem 1.25rem;
		border: 1px solid var(--ld-border);
		border-radius: var(--ld-radius-card);
		background: var(--ld-surface);
	}
	@media (min-width: 40rem) {
		.map {
			padding: 1.5rem 1.75rem;
		}
	}
</style>
