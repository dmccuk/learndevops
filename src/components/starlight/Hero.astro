---
// Home page hero (spec section 6, item 2). Only the home page sets `hero`.
import { REPO_URL, url } from '../../lib/url';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};

const lines = [
	{ cmd: 'git push origin main', out: 'ok lint  ok test  ok build' },
	{ cmd: 'kubectl apply -f app.yaml', out: 'deployment.apps/app configured' },
	{ cmd: 'kubectl rollout status deploy/app', out: 'successfully rolled out' },
	{ cmd: 'curl -s https://[your-app]/health', out: '{"status": "ok"}' },
];
const description =
	'A terminal showing a change going from git push to production: ' +
	lines.map((l) => `${l.cmd} returns ${l.out}`).join('; ') +
	'.';
---

<section class="hero">
	<div class="copy">
		<p class="ld-label">Free · Hands-on · Nothing to install to start</p>
		<h1 id="_top" data-page-title>{title}</h1>
		{tagline && <p class="tagline">{tagline}</p>}
		<div class="actions">
			<a class="ld-button" href={url('/units/l1/')}>Start module L1</a>
			<a class="ld-button secondary" href={REPO_URL}>View the code on GitHub</a>
		</div>
		<p class="small">
			Works on Windows, Mac and Linux. All you need is a browser and a free GitHub account.
		</p>
	</div>
	<div class="terminal" role="img" aria-label={description}>
		<div class="bar" aria-hidden="true"><span></span><span></span><span></span></div>
		<div class="screen" aria-hidden="true">
			{
				lines.map((l, i) => (
					<div class="pair" style={`--i: ${i}`}>
						<div class="cmd">
							<span class="prompt">$</span> {l.cmd}
						</div>
						<div class="out">{l.out}</div>
					</div>
				))
			}
			<div class="cursor-line" style="--i: 4"><span class="prompt">$</span> <span class="cursor"></span></div>
		</div>
	</div>
</section>

<style>
	.hero {
		display: grid;
		gap: 2.5rem;
		align-items: center;
		padding-block: 2rem 3rem;
	}
	@media (min-width: 56rem) {
		.hero {
			grid-template-columns: 1.1fr 1fr;
			padding-block: 4rem 5rem;
		}
	}
	h1 {
		margin: 0.75rem 0 1rem;
		font-size: var(--sl-text-h1);
		line-height: 1.08;
		letter-spacing: -0.02em;
		font-weight: 700;
	}
	.tagline {
		max-width: 36rem;
		font-size: 1.1875rem;
		color: var(--ld-text);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.small {
		margin-top: 1rem;
		font-size: 0.9375rem;
		color: var(--ld-dim);
	}
	.terminal {
		min-width: 0;
		border: 1px solid var(--ld-border);
		border-radius: var(--ld-radius-card);
		background: var(--ld-terminal);
		overflow: hidden;
	}
	.bar {
		display: flex;
		gap: 0.4rem;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid #26303a;
	}
	.bar span {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: #26303a;
	}
	.screen {
		padding: 1.25rem 1rem 1.5rem;
		font-family: var(--__sl-font-mono);
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--ld-terminal-text);
		overflow-x: auto;
	}
	.pair,
	.cursor-line {
		opacity: 0;
		animation: appear 0.4s ease-out forwards;
		animation-delay: calc(var(--i) * 1.1s + 0.3s);
	}
	.pair + .pair {
		margin-top: 0.6rem;
	}
	.cursor-line {
		margin-top: 0.6rem;
	}
	.cmd {
		white-space: pre;
	}
	.out {
		color: var(--ld-terminal-ok);
		white-space: pre;
	}
	.prompt {
		color: var(--ld-terminal-prompt);
	}
	.cursor {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		vertical-align: text-bottom;
		background: var(--ld-terminal-text);
		animation: blink 1s steps(1) infinite;
	}
	@keyframes appear {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pair,
		.cursor-line {
			opacity: 1;
			animation: none;
		}
		.cursor {
			animation: none;
		}
	}
</style>
